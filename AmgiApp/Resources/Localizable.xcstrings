    "Synced — ^[%lld change](inflect: true) up, ^[%lld change](inflect: true) down." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期しました — %lld 件送信、%lld 件受信。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화됨 — 변경 사항 %lld개 올림, %lld개 내려받음."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已同步 — 上传 %lld 项更改，下载 %lld 项更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已同步 — 上傳 %lld 項更改，下載 %lld 項更改。"
          }
        }
      }
    },
    "Syncs your collection with the sync server." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを同期サーバーと同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션을 동기화 서버와 동기화합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的集合与同步服务器同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將你的集合與同步伺服器同步。"
          }
        }
      }
    },
    "That deck is no longer available." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのデッキは利用できなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 덱은 더 이상 사용할 수 없습니다."
