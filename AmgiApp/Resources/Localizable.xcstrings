    "^[%lld card](inflect: true) due in %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ で %1$lld 枚のカードが期日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에 만기 카드 %1$lld장이 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中有 %1$lld 张卡片到期。"
