        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中沒有到期的卡片。"
          }
        }
      }
    },
    "Open Amgi once so it can publish its deck counts, then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッキの枚数を反映するため一度 Amgi を開いてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덱 수를 반영하도록 Amgi를 한 번 연 다음 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先打开一次 Amgi 以发布牌组数量，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先開啟一次 Amgi 以釋出牌組數量，然後重試。"
          }
        }
      }
    },
    "Opens Amgi and starts reviewing a deck." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi を開いてデッキの復習を始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi를 열고 덱 복습을 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Amgi 并开始复习一个牌组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 Amgi 並開始複習一個牌組。"
          }
        }
      }
    },
    "Reports how many cards are waiting for review." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復習待ちのカードの枚数を伝えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복습을 기다리는 카드 수를 알려줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告有多少张卡片等待复习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告有多少張卡片等待複習。"
          }
        }
      }
    },
