          "stringUnit" : {
            "state" : "translated",
            "value" : "完成"
          }
        }
      }
    },
    "If you sync, your cards are safe on the server and will come back after a reset." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期している場合、カードはサーバーに安全に保存されており、リセット後に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화를 사용 중이라면 카드는 서버에 안전하게 있으며 초기화 후 다시 돌아옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你使用同步，卡片会安全地保存在服务器上，重置后会恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你使用同步，卡片會安全地儲存在伺服器上，重置後會恢復。"
          }
        }
      }
    },
