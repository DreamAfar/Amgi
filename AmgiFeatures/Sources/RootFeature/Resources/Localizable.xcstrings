    "Only one eligible word. Add more vocabulary cards to see another." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象の単語が 1 つしかありません。単語カードを追加すると別の単語が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당하는 단어가 하나뿐입니다. 단어 카드를 더 추가하면 다른 단어를 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一个符合条件的单词。添加更多词汇卡片即可看到其他单词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一個符合條件的單詞。新增更多詞彙卡片即可看到其他單詞。"
