{
  "sourceLanguage" : "en",
  "strings" : {
    "Cancel" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Collection removed. Quit and reopen Amgi, then sync to restore your cards." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを削除しました。Amgi を終了して再度開き、同期してカードを復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션을 삭제했습니다. Amgi를 종료했다가 다시 열고 동기화해서 카드를 복원하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合已移除。请退出并重新打开 Amgi，然后同步以恢复卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合已移除。請退出並重新開啟 Amgi，然後同步以恢復卡片。"
          }
        }
      }
    },
    "Couldn't open either profile's collection. Quit and reopen Amgi. If that doesn't help, reset the collection from Settings > Maintenance." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらのプロファイルのコレクションも開けませんでした。Amgi を終了して再度開いてください。それでも解決しない場合は、「設定 > メンテナンス」でコレクションをリセットしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 프로필의 컬렉션을 모두 열 수 없습니다. Amgi를 종료했다가 다시 여세요. 그래도 안 되면 설정 > 유지 관리에서 컬렉션을 초기화하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开任何一个配置文件的集合。请退出并重新打开 Amgi。如果仍有问题，请在“设置 > 维护”中重置集合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟任何一個設定檔的集合。請退出並重新開啟 Amgi。如果仍有問題，請在「設定 > 維護」中重置集合。"
          }
        }
      }
    },
    "Couldn't open your collection" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを開けませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션을 열 수 없습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开你的集合"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟你的集合"
          }
        }
      }
    },
    "Couldn't switch profile" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルを切り替えられませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 전환할 수 없습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换配置文件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法切換設定檔"
          }
        }
      }
    },
    "Delete Collection" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを削除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션 삭제"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除集合"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除集合"
          }
        }
      }
    },
    "Deletes the local collection and sync credentials for this profile. Other profiles are untouched." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルのローカルコレクションと同期の認証情報を削除します。ほかのプロファイルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필의 로컬 컬렉션과 동기화 자격 증명을 삭제합니다. 다른 프로필은 영향을 받지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此配置文件的本地集合和同步凭据。其他配置文件不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除此設定檔的本地集合和同步憑證。其他設定檔不受影響。"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
