    "Allow microphone access in Settings to record audio onto cards." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードに音声を録音するには、設定でマイクへのアクセスを許可してください。"
