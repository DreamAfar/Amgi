{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" will be removed and decks using it will switch to \"%@\"." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は削除され、これを使っているデッキは「%@」に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'이(가) 제거되고, 이를 쓰는 덱은 '%@'(으)로 전환됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被移除，使用它的牌组将改用“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將被移除，使用它的牌組將改用「%@」。"
          }
        }
      }
    },
