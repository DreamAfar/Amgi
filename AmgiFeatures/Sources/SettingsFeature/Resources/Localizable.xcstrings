    "Removes the server, credentials, and switches the app to local-only mode." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーと認証情報を削除し、アプリをローカルのみのモードに切り替えます。"
          }
