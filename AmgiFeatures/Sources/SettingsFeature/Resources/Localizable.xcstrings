    },
    "Needs a controller iOS supports with a full button layout, such as an Xbox, PlayStation or 8BitDo controller in its Xbox or macOS mode. The thumbsticks always scroll the card." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS が対応するフルボタン配列のコントローラが必要です（Xbox、PlayStation、または Xbox／macOS モードの 8BitDo など）。スティックは常にカードをスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 지원하는 전체 버튼 배열 컨트롤러가 필요합니다(Xbox, PlayStation, 또는 Xbox/macOS 모드의 8BitDo 등). 스틱은 항상 카드를 스크롤합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 iOS 支持、按键齐全的手柄，例如 Xbox、PlayStation，或处于 Xbox／macOS 模式的 8BitDo。摇杆始终用于滚动卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 iOS 支援、按鍵齊全的手把，例如 Xbox、PlayStation，或處於 Xbox／macOS 模式的 8BitDo。搖桿一律用於捲動卡片。"
          }
        }
      }
    },
