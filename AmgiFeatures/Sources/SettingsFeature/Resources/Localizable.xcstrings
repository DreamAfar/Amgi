    "The profile switcher is hidden automatically while you have only one profile. Profiles are always available here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルが 1 つしかないときは、切り替えボタンは自動的に非表示になります。プロファイルはいつでもここから管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필이 하나뿐이면 프로필 전환기가 자동으로 숨겨집니다. 프로필은 언제든 여기서 관리할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一个配置文件时，配置文件切换器会自动隐藏。在这里始终可以管理配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一個設定檔時，設定檔切換器會自動隱藏。在這裡始終可以管理設定檔。"
          }
        }
      }
    },
