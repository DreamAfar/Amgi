    "Ignores a tap that comes right after the card turns over, so a quick double tap doesn't show the answer and grade it at once." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードがめくれた直後のタップを無視し、素早いダブルタップで解答の表示と評価が同時に起きないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드가 넘어간 직후의 탭을 무시해, 빠른 두 번 탭으로 답 보기와 평가가 한꺼번에 일어나지 않게 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略卡片翻面后紧接着的点击，避免快速连点时同时显示答案又评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略卡片翻面後緊接著的點擊，避免快速連點時同時顯示答案又評分。"
          }
        }
