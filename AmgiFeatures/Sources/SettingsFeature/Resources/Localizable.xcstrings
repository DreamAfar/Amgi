    "That note no longer exists." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのノートはもう存在しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 노트는 더 이상 없습니다."
          }
        },
        "zh-Hans" : {
