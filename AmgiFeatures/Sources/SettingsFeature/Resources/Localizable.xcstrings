    "Adds AI Explain, Translate, Speak and Make Card to the menu that appears when you select text on a card." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードのテキストを選択したときのメニューに「AI で解説」「翻訳」「読み上げ」「カードを作成」を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드의 텍스트를 선택했을 때 나타나는 메뉴에 AI 설명, 번역, 읽어 주기, 카드 만들기를 추가합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在卡片上选中文字时弹出的菜单里，加入「AI 解释」「翻译」「朗读」「制卡」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在卡片上選取文字時彈出的選單裡，加入「AI 解釋」「翻譯」「朗讀」「製卡」。"
          }
        }
      }
    },
