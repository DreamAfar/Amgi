{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld eligible words. Confirm that the word and meaning look right." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象の単語は %lld 個です。単語と意味が正しく表示されているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당하는 단어가 %lld개 있습니다. 단어와 뜻이 올바른지 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个符合条件的单词。请确认单词和释义显示正确。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 個符合條件的單詞。請確認單詞和釋義顯示正確。"
          }
        }
      }
    },
