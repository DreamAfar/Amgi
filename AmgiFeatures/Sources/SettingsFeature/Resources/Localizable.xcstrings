    "Swipe up or down starting at the left or right edge of the screen; elsewhere a vertical drag scrolls the card." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下のスワイプは画面の左端か右端から始めてください。それ以外の縦ドラッグはカードをスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위아래 쓸기는 화면 왼쪽이나 오른쪽 가장자리에서 시작하세요. 그 밖의 세로 드래그는 카드를 스크롤합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下滑动需从屏幕左边缘或右边缘开始；其他位置的纵向拖动用于滚动卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下滑動需從螢幕左邊緣或右邊緣開始；其他位置的縱向拖曳用於捲動卡片。"
          }
        }
      }
    },
