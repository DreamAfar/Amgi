            "value" : "新增"
          }
        }
      }
    },
    "Add Field" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールドを追加"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드 추가"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加字段"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增欄位"
          }
        }
      }
    },
    "Adding, removing or reordering fields, or changing the sort field, changes the collection's structure. The next sync will have to upload or download the whole collection, and changes made on other devices since the last sync may be lost." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールドの追加・削除・並べ替え、または並べ替えフィールドの変更は、コレクションの構造を変更します。次回の同期ではコレクション全体をアップロードまたはダウンロードする必要があり、前回の同期以降にほかの端末で行った変更は失われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드를 추가·삭제하거나 순서를 바꾸거나 정렬 필드를 바꾸면 컬렉션 구조가 바뀝니다. 다음 동기화 때 컬렉션 전체를 업로드하거나 다운로드해야 하며, 마지막 동기화 이후 다른 기기에서 한 변경 사항은 사라질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加、删除字段、调整字段顺序或更改排序字段，都会改变集合的结构。下次同步时必须上传或下载整个集合，其他设备上自上次同步以来的更改可能会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增、刪除欄位、調整欄位順序或更改排序欄位，都會改變集合的結構。下次同步時必須上傳或下載整個集合，其他裝置上自上次同步以來的更改可能會丟失。"
          }
        }
      }
    },
    "An unknown error occurred." : {
      "localizations" : {
