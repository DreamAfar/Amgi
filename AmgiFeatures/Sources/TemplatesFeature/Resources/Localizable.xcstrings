    "Delete \"%@\"? Cards using this notetype will be removed too." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除しますか？このノートタイプを使うカードも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'을(를) 삭제할까요? 이 노트 유형을 쓰는 카드도 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除“%@”？使用此笔记模板的卡片也会被删除。"
