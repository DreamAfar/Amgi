{
  "sourceLanguage" : "en",
  "strings" : {
    "A field name can't contain : \" { or }." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールド名に : \" { } は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드 이름에는 : \" { }를 쓸 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字段名不能包含 : \" { 或 }。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欄位名不能包含 : \" { 或 }。"
          }
        }
      }
    },
    "A field name can't start with #, / or ^." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールド名を #、/、^ で始めることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드 이름은 #, /, ^로 시작할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字段名不能以 #、/ 或 ^ 开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欄位名不能以 #、/ 或 ^ 開頭。"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加"
          }
        },
