    "Drag to reorder with Edit. The order is the order fields appear in when you edit a note." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集」をタップするとドラッグで並べ替えられます。ノートを編集するときのフィールドの順序になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집을 누르면 드래그해서 순서를 바꿀 수 있습니다. 노트를 편집할 때 필드가 이 순서로 나타납니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点“编辑”后可拖动调整顺序。编辑笔记时字段按此顺序排列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點「編輯」後可拖動調整順序。編輯筆記時欄位按此順序排列。"
          }
        }
      }
    },
