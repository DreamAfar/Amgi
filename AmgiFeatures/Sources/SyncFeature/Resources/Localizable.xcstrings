    "Your local and server collections have diverged. Choose how to reconcile them — Merge is the safest option." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルとサーバーのコレクションが食い違っています。解決方法を選んでください。マージが最も安全です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬과 서버의 컬렉션이 서로 달라졌습니다. 해결 방법을 고르세요. 병합이 가장 안전합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地和服务器上的集合已产生分歧。请选择如何处理——合并是最安全的选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
