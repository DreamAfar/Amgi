    "Amgi" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi"
          }
        }
      }
    },
    "Amgi shows each card exactly when you're about to forget. The longer you remember, the rarer it returns." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi は、忘れかけたちょうどそのときにカードを表示します。長く覚えているほど、出題の間隔は空いていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi는 잊어버리기 직전에 카드를 정확히 보여줍니다. 오래 기억할수록 덜 자주 나옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi 会在你快要忘记时准确地展示每张卡片。记得越久，它出现得越少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amgi 會在你快要忘記時準確地展示每張卡片。記得越久，它出現得越少。"
          }
        }
      }
    },
    "AnkiWeb is supported by sales of AnkiMobile. Please consider purchasing a copy to support the sync servers." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb は AnkiMobile の売上で運営されています。同期サーバーを支援するため、購入をご検討ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb은 AnkiMobile 판매 수익으로 운영됩니다. 동기화 서버를 지원하려면 구매를 고려해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb 依靠 AnkiMobile 的销售收入维持。请考虑购买一份，以支持同步服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb 依靠 AnkiMobile 的銷售收入維持。請考慮購買一份，以支援同步伺服器。"
          }
        }
      }
    },
