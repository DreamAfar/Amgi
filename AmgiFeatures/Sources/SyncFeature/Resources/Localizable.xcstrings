        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入一個牌組並開始複習。每天五分鐘就夠了。"
          }
        }
      }
    },
    "Keeps cards from both sides; conflicts use newest" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
