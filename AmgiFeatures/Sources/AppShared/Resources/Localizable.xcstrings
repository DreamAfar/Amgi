{
  "sourceLanguage" : "en",
  "strings" : {
    "0 = today, 1 = tomorrow, 3-7 = a random day in that range. Append ! to also reset the interval, e.g. 3!." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 = 今日、1 = 明日、3-7 = その範囲のランダムな日。末尾に ! を付けると間隔もリセットします（例: 3!）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 = 오늘, 1 = 내일, 3-7 = 그 범위 안의 임의의 날. 끝에 !를 붙이면 복습 주기도 초기화합니다 (예: 3!)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 = 今天，1 = 明天，3-7 = 该范围内随机一天。末尾加 ! 会同时重置间隔，例如 3!。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 = 今天，1 = 明天，3-7 = 該範圍內隨機一天。末尾加 ! 會同時重置間隔，例如 3!。"
          }
        }
      }
    },
