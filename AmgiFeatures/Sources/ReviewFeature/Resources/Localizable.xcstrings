          }
        }
      }
    },
    "This card uses the AnkiDroid JavaScript API without a version and developer contact, so its script features are off." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードはバージョンと開発者の連絡先なしでAnkiDroid JavaScript APIを使っているため、スクリプト機能はオフです。"
          }
