        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードはAnkiDroid JavaScript API %1$@を要求していますが、Amgiが対応しているのは%2$@です。デッキの開発者に連絡してください：%3$@"
