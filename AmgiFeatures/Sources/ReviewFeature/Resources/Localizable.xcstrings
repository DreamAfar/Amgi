    "Overrides the global choice for every card of this template. Stored on this device only." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテンプレートのすべてのカードで全体の設定を上書きします。この端末にのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 템플릿의 모든 카드에 대해 전체 설정을 재정의합니다. 이 기기에만 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对此模板的所有卡片覆盖全局设置。仅保存在此设备上。"
